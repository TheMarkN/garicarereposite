# Copy this file to .env (never commit .env). Use the same Neon string in both if you only have one.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Any long random string (32+ characters)
AUTH_SECRET="replace-with-a-long-random-string"
# Temporary password given to the demo users created by the seed. Change after first login.
SEED_PASSWORD="ChangeMe-2026!"
